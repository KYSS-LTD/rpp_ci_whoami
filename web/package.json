{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "npm run build:uav",
		"dev": "next dev",
		"prebuild": "npm run build:uav",
		"build:uav": "npm --prefix games/uav-operator run build",
		"build": "next build",
		"start": "next start",
		"dev:cooking": "vite --config games/cooking/vite.config.ts --configLoader runner",
		"predev:cooking": "node scripts/copy-portal-bridge.mjs cooking",
		"build:cooking": "vite build --config games/cooking/vite.config.ts --configLoader runner",
		"capture:tutorial": "node scripts/capture-tutorial.mjs",
		"prebuild:cooking": "node scripts/copy-portal-bridge.mjs cooking",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check:dashes": "node scripts/check-dashes.mjs",
		"format": "prettier --write .",
		"check": "npm run typecheck && npm run test && npm run check:dashes && npm run lint"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"next": "16.4.6",
		"pdf-lib": "^1.17.1",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.19.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/three": "^0.187.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.6",
		"gifenc": "^1.0.3",
		"jsdom": "^29.1.1",
		"prettier": "^3.10.1",
		"three": "^0.187.0",
		"typescript": "^5",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
